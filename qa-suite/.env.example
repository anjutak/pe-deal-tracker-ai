# Copy this file to .env (same folder) and fill in your values.
# .env is git-ignored - never commit real keys.

# Langflow flow endpoint: Langflow > your flow > Share > API access
LANGFLOW_URL=http://localhost:7860/api/v1/run/YOUR-FLOW-ID
LANGFLOW_API_KEY=sk-your-langflow-key

# Claude judge (console.anthropic.com > API Keys). Leave empty to skip the judge.
ANTHROPIC_API_KEY=sk-ant-your-key
# JUDGE_MODEL=claude-sonnet-5-5

# Seconds between questions (keeps the Gemini free tier under its per-minute limit)
# REQUEST_DELAY=7
